{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Ranked bars: the ten longest trails. Larapinta sections are purple; every other trail is grey.",
  "width": "container",
  "height": 416,
  "data": {"url": "data/trails_clean.csv", "format": {"type": "csv", "parse": {"km": "number", "hours": "number"}}},
  "transform": [
    {"filter": "isValid(datum.km)"},
    {"window": [{"op": "row_number", "as": "rk"}], "sort": [{"field": "km", "order": "descending"}]},
    {"filter": "datum.rk <= 10"},
    {"calculate": "datum.map_group == 'Larapinta Trail' ? 'Larapinta section' : 'Other trails'", "as": "highlight"}
  ],
  "encoding": {
    "y": {
      "field": "short",
      "type": "nominal",
      "sort": {"field": "km", "op": "max", "order": "descending"},
      "title": null,
      "axis": {"labelLimit": 210}
    },
    "x": {"field": "km", "type": "quantitative", "title": "Distance (km)", "scale": {"domain": [0, 32]}}
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 2, "height": {"band": 0.72}},
      "encoding": {
        "color": {
          "field": "highlight",
          "type": "nominal",
          "scale": {"domain": ["Larapinta section", "Other trails"], "range": ["#8C3B72", "#BAC2BD"]},
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 140,
            "labelFontSize": 12,
            "columnPadding": 18,
            "padding": 4
          }
        },
        "tooltip": [
          {"field": "trail", "title": "Trail"},
          {"field": "map_group", "title": "Area"},
          {"field": "km", "title": "Distance (km)"},
          {"field": "hours", "title": "Time (hours)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 5, "fontSize": 11, "fontWeight": 600},
      "encoding": {"text": {"field": "km", "type": "quantitative", "format": ".1f"}}
    }
  ]
}
