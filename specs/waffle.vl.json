{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "col": "number",
        "row": "number"
      }
    }
  },
  "facet": {
    "column": {
      "field": "map_group",
      "type": "nominal",
      "sort": [
        "SE Queensland",
        "Wilsons Promontory",
        "Flinders Ranges",
        "Stirling Range",
        "Larapinta Trail"
      ],
      "title": null,
      "header": {
        "labelFontSize": 13,
        "labelFontWeight": 700,
        "labelOrient": "top"
      }
    }
  },
  "spec": {
    "width": 168,
    "height": 90,
    "mark": {
      "type": "square",
      "size": 560,
      "stroke": "#fff",
      "strokeWidth": 1
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null
      },
      "color": {
        "field": "band",
        "type": "nominal",
        "scale": {
          "domain": [
            "Easy",
            "Moderate",
            "Hard",
            "Very hard",
            "Not graded"
          ],
          "range": [
            "#7DB38A",
            "#E2B73F",
            "#DB6B2D",
            "#8E2B3A",
            "#C3C9C4"
          ]
        },
        "legend": {
          "title": "Grade band",
          "orient": "bottom",
          "direction": "horizontal",
          "columns": 5
        }
      },
      "tooltip": [
        {
          "field": "trail",
          "title": "Trail"
        },
        {
          "field": "band",
          "title": "Grade band"
        }
      ]
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}